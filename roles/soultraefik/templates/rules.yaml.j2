http:
  #region routers
  routers:
    router-homeassistant:
      entryPoints:
        - "https"
      rule: "Host(`home.{{ secret_domain_full }}`)"
      middlewares:
        - default-headers
        - https-redirectscheme
      tls: {}
      service: homeassistant
    router-mcmap:
      entryPoints:
        - "https"
      rule: Host(`mcmap.{{ secret_domain_full }}`)
      middlewares:
        - default-headers
        - https-redirectscheme
      tls: {}
      service: mcmap

#endregion
#region services
  services:
    homeassistant:
      loadBalancer:
        servers:
          - url: "http://soulhass:8123"
        passHostHeader: true
    mcmap:
      loadBalancer:
        servers:
          - url: "http://10.42.10.200:8081"
        passHostHeader: true
#endregion
  middlewares:
    https-redirectscheme:
      redirectScheme:
        scheme: https
        permanent: true
    default-headers:
      headers:
        frameDeny: true
        browserXssFilter: true
        contentTypeNosniff: true
        forceSTSHeader: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 15552000
        customFrameOptionsValue: SAMEORIGIN
        customRequestHeaders:
          X-Forwarded-Proto: https
